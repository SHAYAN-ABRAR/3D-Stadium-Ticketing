# No secrets and no services: every visitor's data lives in their own browser (IndexedDB),
# the checkout is a demo and no email is sent. Both settings are optional.

# Language for visitors who haven't chosen one: en or bn.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Set to 1 only by the E2E test server (turns on the test hooks, turns off the sales simulator).
NEXT_PUBLIC_E2E=
